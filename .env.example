NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1
APP_NAME=DevOpsMentOr
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3001

# MySQL connection string: mysql://user:password@host:port/database
DATABASE_URL=
# Redis connection string: redis://host:port
REDIS_URL=redis://localhost:6379

# Generate strong secrets, min 32 chars each (e.g. `openssl rand -base64 48`)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12

LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

OTP_TTL_MINUTES=15
INVITE_TTL_HOURS=48
IDENTITY_CACHE_TTL_SECONDS=60
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

TOTP_ISSUER=DevOpsMentOr
TWO_FACTOR_ENCRYPTION_KEY=change-me-2fa-encryption-key-min-32-chars

# SMTP (optional in development; OTP emails are logged when empty in dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DevOpsMentOr <no-reply@devopsmentor.io>

# OAuth providers: Google and GitHub only
# Credentials from Google Cloud Console / GitHub OAuth App settings
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Labs, Execution Engine & AI Mentor ───────────────────────────────
# External container orchestration API (leave empty in dev; adapters throw
# user-safe 503/500 errors when unset)
CONTAINER_ORCHESTRATION_API_URL=
# LLM provider for the AI Mentor (leave empty in dev; AI Mentor returns 503)
LLM_API_URL=
LLM_API_KEY=
AI_MENTOR_MODEL=
AI_MENTOR_SYSTEM_PROMPT=You are the DevOps Mentor AI assistant. You help learners with their DevOps labs, lessons and tracks. Answer concisely, prefer practical command-line examples, and never reveal internal infrastructure details.
AI_MENTOR_SESSION_TTL_SECONDS=7200
AI_MENTOR_RATE_LIMIT_MAX=30
AI_MENTOR_RATE_LIMIT_WINDOW_SECONDS=3600
# TTL monitor sweep interval; expired instances are force-terminated
LAB_TTL_MONITOR_INTERVAL_SECONDS=60
LAB_EXTEND_MINUTES=60
LAB_MAX_EXTENSIONS=3
# ─── Achievements, Gamification & Certification ────────────────────
# Public certificate verification page origin (required at boot)
CERTIFICATE_VERIFY_BASE_URL=http://localhost:5173
# Leaderboard recompute cadence in minutes
LEADERBOARD_RECOMPUTE_INTERVAL_MINUTES=15
# ─── Subscription, Billing & Entitlements ───────────────────────────
# Stripe integration (leave empty in dev; the Stripe adapter throws a
# user-safe 502/503 error when unset). Price IDs come from the Stripe
# dashboard; the webhook secret from the Stripe webhook endpoint config.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PREMIUM_MONTHLY=
STRIPE_PRICE_ID_PREMIUM_ANNUAL=
STRIPE_PRICE_ID_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ID_ENTERPRISE_ANNUAL=
STRIPE_PRICE_ID_STUDENT_MONTHLY=
STRIPE_PRICE_ID_STUDENT_ANNUAL=
STRIPE_CURRENCY=usd
# Nightly expiry sweep cadence (hours); marks non-renewing subscriptions
# past end_date as inactive 
SUBSCRIPTION_EXPIRY_CHECK_INTERVAL_HOURS=24
