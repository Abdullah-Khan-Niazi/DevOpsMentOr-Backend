NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1
APP_NAME=DevOpsMentOr
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3001

# MySQL connection string: mysql://user:password@host:port/database
DATABASE_URL=
# Redis connection string: redis://host:port
REDIS_URL=redis://localhost:6379

# Generate strong secrets, min 32 chars each (e.g. `openssl rand -base64 48`)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12

LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

OTP_TTL_MINUTES=15
INVITE_TTL_HOURS=48
IDENTITY_CACHE_TTL_SECONDS=60
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

TOTP_ISSUER=DevOpsMentOr
TWO_FACTOR_ENCRYPTION_KEY=change-me-2fa-encryption-key-min-32-chars

# SMTP (optional in development; OTP emails are logged when empty in dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DevOpsMentOr <no-reply@devopsmentor.io>

# OAuth providers: Google and GitHub only
# Credentials from Google Cloud Console / GitHub OAuth App settings
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=